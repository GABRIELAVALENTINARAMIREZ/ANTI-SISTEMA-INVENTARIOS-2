<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="09-create-recetas-table" author="gvalen">
        <createTable tableName="recetas">
            <column name="id_receta" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nombre" type="VARCHAR(120)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="categoria_menu" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
            <column name="precio_venta" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tiempo_preparacion_min" type="INT" defaultValueNumeric="10"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
