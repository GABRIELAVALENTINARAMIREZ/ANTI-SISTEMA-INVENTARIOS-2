<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="06-create-productos-table" author="gvalen">
        <createTable tableName="productos">
            <column name="id_producto" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="codigo" type="VARCHAR(30)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="nombre" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="imagen" type="VARCHAR(255)"/>
            <column name="id_categoria" type="INT">
                <constraints nullable="false" foreignKeyName="fk_prod_cat" references="categorias(id_categoria)"/>
            </column>
            <column name="id_proveedor" type="INT">
                <constraints nullable="false" foreignKeyName="fk_prod_prov" references="proveedores(id_proveedor)"/>
            </column>
            <column name="id_ubicacion" type="INT">
                <constraints foreignKeyName="fk_prod_ubic" references="ubicaciones(id_ubicacion)"/>
            </column>
            <column name="cantidad" type="DECIMAL(10,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="unidad_medida" type="VARCHAR(30)" defaultValue="unidades">
                <constraints nullable="false"/>
            </column>
            <column name="stock_minimo" type="DECIMAL(10,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="precio_compra" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="actualizado_en" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <createIndex tableName="productos" indexName="idx_prod_cat">
            <column name="id_categoria"/>
        </createIndex>
        <createIndex tableName="productos" indexName="idx_prod_prov">
            <column name="id_proveedor"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
