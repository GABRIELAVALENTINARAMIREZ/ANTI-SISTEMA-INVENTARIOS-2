<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="03-create-categorias-table" author="gvalen">
        <createTable tableName="categorias">
            <column name="id_categoria" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nombre" type="VARCHAR(80)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="descripcion" type="VARCHAR(255)"/>
            <column name="icono" type="VARCHAR(40)" defaultValue="Package"/>
            <column name="color" type="VARCHAR(20)" defaultValue="#E63946"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
