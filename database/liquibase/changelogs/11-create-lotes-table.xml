<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="11-create-lotes-table" author="gvalen">
        <createTable tableName="lotes">
            <column name="id_lote" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="numero_lote" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="id_producto" type="INT">
                <constraints nullable="false" foreignKeyName="fk_lote_prod" references="productos(id_producto)"/>
            </column>
            <column name="cantidad" type="DECIMAL(10,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_ingreso" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_vencimiento" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="id_ubicacion" type="INT">
                <constraints foreignKeyName="fk_lote_ubic" references="ubicaciones(id_ubicacion)"/>
            </column>
            <column name="dado_de_baja" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
        <createIndex tableName="lotes" indexName="idx_lote_vencimiento">
            <column name="fecha_vencimiento"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
